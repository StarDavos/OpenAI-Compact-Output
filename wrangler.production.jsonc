{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compact-code-viewer",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "nodejs_als"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "observability": {
    "enabled": false
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ]
}
