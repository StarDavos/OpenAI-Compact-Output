{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compact-code-viewer-local-preview",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "no_nodejs_compat",
    "no_nodejs_compat_v2",
    "nodejs_als"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "observability": {
    "enabled": false
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8788,
    "local_protocol": "http"
  }
}
